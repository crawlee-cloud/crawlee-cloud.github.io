{"version": 2, "width": 80, "height": 20, "title": "Crawlee Cloud — deploy"}
[0.0, "o", "# 1. Boot the platform on your own box.\r\n"]
[0.4, "o", "$ docker compose up -d\r\n"]
[1.2, "o", "  Creating crawlee-api      ... done\r\n"]
[1.6, "o", "  Creating crawlee-runner   ... done\r\n"]
[2.0, "o", "  Creating crawlee-postgres ... done\r\n"]
[2.6, "o", "\r\n# 2. Push your existing Apify Actor — no rewrite.\r\n"]
[3.0, "o", "$ crawlee-cloud push my-actor\r\n"]
[3.8, "o", "  Building image my-actor:0.1.0 ...\r\n"]
[5.2, "o", "  Build #42 ready\r\n"]
[5.8, "o", "\r\n# 3. Run it.\r\n"]
[6.0, "o", "$ crawlee-cloud run my-actor\r\n"]
[6.6, "o", "  Run abc123 started\r\n"]
[8.0, "o", "  Run abc123 SUCCEEDED — 1,243 items in dataset\r\n"]
[8.4, "o", "$ "]
